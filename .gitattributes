# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.cc text
*.cpp text
*.h text
*.hpp text
*.pp3 text

# Files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.vcproj text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.bmp binary
*.jpg binary
*.jpeg binary
*.ora binary
*.png binary
*.tiff binary
*.zip binary

# TGMR identities authenticate exact bytes across platform checkouts.
rtdata/models/*.tgmr binary
rtdata/models/*.json -text
rtdata/models/xtrans-tgmr-CORPUS-NOTICE.txt -text whitespace=-blank-at-eof
tools/tgmr_trainer/corpus-v1/** -text
# The final empty TSV column is meaningful, not accidental trailing space.
tools/tgmr_trainer/corpus-v1/reconstruction.tsv whitespace=-blank-at-eol
doc/papers/xtrans-tgmr/** -text
devnotes/images/**/*.json -text

# Don't alter LibRaw files managed using git subtree.
# Must be last to override all previous settings!
external/libraw/** -text
